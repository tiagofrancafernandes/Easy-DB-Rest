@baseUrl = http://localhost:8000/api
@token = YOUR_TOKEN_HERE
@connectionId = 1
@teamId = 1

### 1. Create a Connection
POST {{baseUrl}}/connections
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "name": "SQLite Testing",
    "driver": "sqlite",
    "database": "/absolute/path/to/database.sqlite"
}

### 2. List Connections
GET {{baseUrl}}/connections
Authorization: Bearer {{token}}
Accept: application/json

### 3. Test Connection via Runtime Config
POST {{baseUrl}}/connection/test
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "connection": {
        "driver": "sqlite",
        "database": "/absolute/path/to/database.sqlite"
    }
}

### 4. Execute Raw Query (Runtime Config)
POST {{baseUrl}}/query
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "type": "raw",
    "query": "SELECT * FROM sqlite_master LIMIT 5",
    "connection": {
        "driver": "sqlite",
        "database": "/absolute/path/to/database.sqlite"
    }
}

### 5. Execute Raw Query (Header Config)
POST {{baseUrl}}/query
Authorization: Bearer {{token}}
Content-Type: text/x-sql
Accept: application/json
X-Config-ID: {{connectionId}}

SELECT * FROM sqlite_master LIMIT 5;

### 6. Execute Builder Query (Runtime Config)
POST {{baseUrl}}/query
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "type": "select",
    "table": "sqlite_master",
    "query": [
        {
            "method": "select",
            "args": ["name", "type"]
        },
        {
            "method": "limit",
            "args": [10]
        }
    ],
    "connection": {
        "driver": "sqlite",
        "database": "/absolute/path/to/database.sqlite"
    }
}

### 7. Delete Connection
DELETE {{baseUrl}}/connections/{{connectionId}}
Authorization: Bearer {{token}}
Accept: application/json

### 8. Share Connection with Team
POST {{baseUrl}}/connections/{{connectionId}}/share
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "team_id": "{{teamId}}",
    "permission": "view"
}
