@baseUrl = https://local.easydbrest.com/api
# @baseUrl = http://localhost:8000/api
@token = Your-Auth-Token-Here
@connectionId = 1
@snippetId = 019dc662-8772-710c-99f5-468843f153b7
@teamId = 019dc662-d29a-730c-9876-468843f153b7
@userId = 5

##########################################################
### --------------------------------------------------------
### 1. CONNECTION MANAGEMENT
### --------------------------------------------------------

##########################################################
### List All Connections
GET {{baseUrl}}/connections
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Get Connection Info
GET {{baseUrl}}/connections/{{connectionId}}
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Create a new MySQL Connection (Advanced)
POST {{baseUrl}}/connections
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "name": "E-Commerce Stats DB",
    "driver": "mysql",
    "host": "db.production.local",
    "port": 3307,
    "database": "ecommerce_metrics",
    "username": "analytics_user",
    "password": "secure_password_in_base64",
    "charset": "utf8mb4",
    "collation": "utf8mb4_unicode_ci",
    "tags": ["production", "analytics", "mysql"]
}

##########################################################
### Share Connection with Team
POST {{baseUrl}}/connections/{{connectionId}}/share
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "team_id": "{{teamId}}",
    "permission": "view"
}

##########################################################
### --------------------------------------------------------
### 2. SNIPPET MANAGEMENT
### --------------------------------------------------------

##########################################################
### List Snippets
GET {{baseUrl}}/snippets
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Create Snippet
POST {{baseUrl}}/snippets
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "name": "queries/active_users.sql",
    "content": "SELECT * FROM users WHERE active = 1;",
    "public_content_slug": "active-users-list",
    "public_content_password": "mypassword",
    "public_content_index": false,
    "tags": ["sql", "admin"]
}

##########################################################
### Get Public Snippet (JSON)
GET {{baseUrl}}/snippets/{{userId}}/active-users-list?password=mypassword
Accept: application/json

##########################################################
### Get Public Snippet (Plain Text)
GET {{baseUrl}}/snippets/{{userId}}/active-users-list?password=mypassword&text
Accept: text/plain

##########################################################
### Share Snippet with Team
POST {{baseUrl}}/snippets/{{snippetId}}/share
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "team_id": "{{teamId}}",
    "permission": "edit"
}

##########################################################
### --------------------------------------------------------
### 3. TEAM MANAGEMENT
### --------------------------------------------------------

##########################################################
### List Teams
GET {{baseUrl}}/teams
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Create Team
POST {{baseUrl}}/teams
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "name": "Backend Team"
}

##########################################################
### Add Member to Team
POST {{baseUrl}}/teams/{{teamId}}/members
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "user_id": "{{userId}}"
}

##########################################################
### --------------------------------------------------------
### 4. DATABASE & SCHEMA MANAGEMENT
### --------------------------------------------------------

##########################################################
### List Databases
GET {{baseUrl}}/connections/{{connectionId}}/databases
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Create Database
POST {{baseUrl}}/connections/{{connectionId}}/databases
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "name": "new_app_db"
}

##########################################################
### List Schemas (PostgreSQL/SQL Server)
GET {{baseUrl}}/connections/{{connectionId}}/schemas
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### --------------------------------------------------------
### 5. TABLE MANAGEMENT
### --------------------------------------------------------

##########################################################
### List Tables
GET {{baseUrl}}/connections/{{connectionId}}/tables
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Create Table
POST {{baseUrl}}/connections/{{connectionId}}/tables
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "table": "tasks",
    "columns": [
        {"name": "id", "type": "id"},
        {"name": "title", "type": "string"},
        {"name": "completed", "type": "boolean", "default": false},
        {"name": "user_id", "type": "unsignedBigInteger"}
    ]
}

##########################################################
### Get Table Details
GET {{baseUrl}}/connections/{{connectionId}}/tables/tasks
Accept: application/json
Authorization: Bearer {{token}}

##########################################################
### Alter Table
PUT {{baseUrl}}/connections/{{connectionId}}/tables/tasks
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}

{
    "add": [
        {"name": "due_date", "type": "timestamp", "nullable": true}
    ],
    "rename": {
        "title": "heading"
    }
}

##########################################################
### --------------------------------------------------------
### 6. QUERY EXECUTION
### --------------------------------------------------------

##########################################################
### Execute Raw SQL using Runtime Connection Config
POST {{baseUrl}}/query
Accept: application/json
Content-Type: application/json
Precognition: true
X-Config-ID: {{connectionId}}
Authorization: Bearer {{token}}

{
    "type": "raw",
    "query": "SELECT * FROM users WHERE active = 1 LIMIT 10",
    "connection": {
        "driver": "pgsql",
        "host": "127.0.0.1",
        "port": 5432,
        "database": "my_database",
        "username": "my_user",
        "password": "my_password_in_base64"
    }
}

##########################################################
### Execute Query Builder
POST {{baseUrl}}/query
Accept: application/json
Content-Type: application/json
Precognition: true
Authorization: Bearer {{token}}
X-Config-ID: {{connectionId}}

{
    "type": "select",
    "table": "orders",
    "query": [
        {
            "method": "where",
            "args": ["total", ">", 100]
        },
        {
            "method": "limit",
            "args": [5]
        }
    ]
}

##########################################################
### Login request
POST {{baseUrl}}/login
Accept: application/json
Content-Type: application/json
Precognition: true

{
    "email": "user@mail.com",
    "password": "password",
    "device_name": "my device name"
}
