        "concurrently": "^9.0.1",
        "iconify-icon": "^2.1.0",
        "laravel-precognition-vue": "^2.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.8.3",
        "sprintf-js": "^1.1.3",
        "tailwindcss": "^4.2.4",
        "vue": "^3.5.12",
        "vue-i18n": "^11.3.2",
        "vue-router": "^5.0.6",
        "vue3-toastify": "^0.2.9"
    },
    "devDependencies": {
        "@types/node": "^22.8.1",
        "@types/sprintf-js": "^1.1.4",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "autoprefixer": "^10.4.20",
        "jsdom": "^29.0.2",
