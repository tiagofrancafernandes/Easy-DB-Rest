{
    "name": "easy-db-console",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "vite": "vite",
        "build": "vue-tsc && vite build",
        "open-in-editor-server": "node open-in-editor-server.js",
        "dev:open-in-editor-server": "node open-in-editor-server.js",
        "dev:with-editor-server": "npx concurrently -n vite,editor-server -c blue,green \"npm:vite\" \"npm:open-in-editor-server\"",
        "dev": "npm run dev:with-editor-server",
        "preview": "vite preview"
    },
    "dependencies": {
